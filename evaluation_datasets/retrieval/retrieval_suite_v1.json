{
  "name": "ai4research-retrieval-suite",
  "version": "1",
  "description": "Eight-case retrieval evaluation suite for comparing BM25, embedding, hybrid retrieval, and future rerankers on realistic ai4research topics.",
  "default_scoring": {
    "minimum_relevance": 2,
    "k_values": [1, 3, 5, 10],
    "note": "Relevance >= 2 is treated as strictly relevant unless a case explicitly overrides it."
  },
  "baseline": {
    "name": "bm25-fulltext-candidate-rerank",
    "description": "Metadata candidate retrieval followed by lazy PDF/OCR/chunk preparation, BM25 chunk retrieval, and paper-level aggregation."
  },
  "cases": [
    {
      "case_id": "agent-memory-trajectory",
      "topic_family": "agent memory and trajectories",
      "dataset_path": "evaluation_datasets/retrieval/agent_memory_trajectory_v1.json",
      "search_result_path": "evaluation_datasets/retrieval/agent_memory_trajectory_v1_search_output.json",
      "metrics_path": "evaluation_datasets/retrieval/agent_memory_trajectory_v1_bm25_metrics.json",
      "minimum_relevance": 1,
      "strict_equivalent": true,
      "notes": "This seed case has no grade-1 judgments, so minimum_relevance=1 and minimum_relevance=2 produce the same relevant set."
    },
    {
      "case_id": "dialogue-trajectory-clustering",
      "topic_family": "dialogue trajectories and clustering",
      "dataset_path": "evaluation_datasets/retrieval/dialogue_trajectory_clustering_v1.json",
      "search_result_path": "evaluation_datasets/retrieval/dialogue_trajectory_clustering_v1_final_search_output.json",
      "metrics_path": "evaluation_datasets/retrieval/dialogue_trajectory_clustering_v1_bm25_strict_metrics.json",
      "minimum_relevance": 2
    },
    {
      "case_id": "agent-trajectory-failure-detection",
      "topic_family": "agent trajectory anomaly and failure detection",
      "dataset_path": "evaluation_datasets/retrieval/agent_trajectory_failure_detection_v1.json",
      "search_result_path": "evaluation_datasets/retrieval/agent_trajectory_failure_detection_v1_final_search_output.json",
      "metrics_path": "evaluation_datasets/retrieval/agent_trajectory_failure_detection_v1_bm25_strict_metrics.json",
      "minimum_relevance": 2,
      "notes": "Weakest BM25 baseline case; useful for testing whether embeddings improve semantic matching beyond keyword overlap."
    },
    {
      "case_id": "multi-agent-planning-execution",
      "topic_family": "multi-agent planning and execution",
      "dataset_path": "evaluation_datasets/retrieval/multi_agent_planning_execution_v1.json",
      "search_result_path": "evaluation_datasets/retrieval/multi_agent_planning_execution_v1_final_search_output.json",
      "metrics_path": "evaluation_datasets/retrieval/multi_agent_planning_execution_v1_bm25_strict_metrics.json",
      "minimum_relevance": 2
    },
    {
      "case_id": "multi-agent-failure-attribution",
      "topic_family": "multi-agent failure attribution and credit assignment",
      "dataset_path": "evaluation_datasets/retrieval/multi_agent_failure_attribution_v1.json",
      "search_result_path": "evaluation_datasets/retrieval/multi_agent_failure_attribution_v1_final_search_output.json",
      "metrics_path": "evaluation_datasets/retrieval/multi_agent_failure_attribution_v1_bm25_strict_metrics.json",
      "minimum_relevance": 2
    },
    {
      "case_id": "question-storming",
      "topic_family": "question storming and proactive inquiry",
      "dataset_path": "evaluation_datasets/retrieval/question_storming_v1.json",
      "search_result_path": "evaluation_datasets/retrieval/question_storming_v1_final_search_output.json",
      "metrics_path": "evaluation_datasets/retrieval/question_storming_v1_bm25_strict_metrics.json",
      "minimum_relevance": 2,
      "notes": "Research-gap style case; no grade-3 direct-match papers were found in the candidate set."
    },
    {
      "case_id": "recursive-inquiry-refinement",
      "topic_family": "recursive inquiry, critique, reflection, and refinement",
      "dataset_path": "evaluation_datasets/retrieval/recursive_inquiry_refinement_v1.json",
      "search_result_path": "evaluation_datasets/retrieval/recursive_inquiry_refinement_v1_final_search_output.json",
      "metrics_path": "evaluation_datasets/retrieval/recursive_inquiry_refinement_v1_bm25_strict_metrics.json",
      "minimum_relevance": 2
    },
    {
      "case_id": "markup-color-highlighting",
      "topic_family": "markup, color highlighting, prompt formatting, and salience",
      "dataset_path": "evaluation_datasets/retrieval/markup_color_highlighting_v1.json",
      "search_result_path": "evaluation_datasets/retrieval/markup_color_highlighting_v1_final_search_output.json",
      "metrics_path": "evaluation_datasets/retrieval/markup_color_highlighting_v1_bm25_strict_metrics.json",
      "minimum_relevance": 2,
      "notes": "Research-gap style case about whether markup/color/highlighting affects LLM or multimodal model attention to salient content."
    }
  ]
}
